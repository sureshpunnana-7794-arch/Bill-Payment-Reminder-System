{
  "name": "paypulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "dev:full": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server:dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run --dir server/tests",
    "test:db": "node test-db.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.59.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
