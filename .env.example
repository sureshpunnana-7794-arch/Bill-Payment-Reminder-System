# ==========================================
# PayPulse Server & Database Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas SRV or Local MongoDB URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/paypulse?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/paypulse
MONGODB_URI=mongodb://127.0.0.1:27017/paypulse

# JWT Secret Keys (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional Frontend API Base URL (leave blank when using Vite proxy)
VITE_API_URL=
